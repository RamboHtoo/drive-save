# Copy to .env and fill in real values. .env is git-ignored; never commit it.

# Public hostname Caddy gets the HTTPS certificate for (docker-compose only).
# Use "localhost" to test the stack on your own machine.
API_DOMAIN=api.example.com

# Tiger Data connection string, required. Use the drivesave_app role (backend/db/app_role.sql), not tsdbadmin.
# Local development: postgresql://postgres:test@localhost:55432/postgres (from scripts/test-db.sh)
DATABASE_URL=postgres://drivesave_app:PASSWORD@HOST:PORT/tsdb?sslmode=require

# Required for admin-only endpoints such as the demo reset.
ADMIN_KEY=change-me

# Comma-separated list of allowed origins, or * for any.
CORS_ORIGINS=*
