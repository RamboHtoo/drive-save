# Copy to .env and fill in real values. .env is git-ignored; never commit it.

# Tiger Data connection string (not used until stage 2).
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/tsdb?sslmode=require

# Required for admin-only endpoints such as the demo reset.
ADMIN_KEY=change-me

# Comma-separated list of allowed origins, or * for any.
CORS_ORIGINS=*
